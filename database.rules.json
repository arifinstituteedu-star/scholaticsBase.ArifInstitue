{
  "rules": {
    ".read": true,
    ".write": true,
    "users": {
      ".indexOn": ["userId", "role", "schoolId", "email"]
    },
    "presence": {
      ".indexOn": ["status", "lastSeen", "schoolId"]
    },
    "notifications": {
      ".indexOn": ["timestamp", "read", "userId", "schoolId"]
    },
    "schoolSync": {
      ".indexOn": ["schoolId", "updatedAt"]
    },
    "schools": {
      ".indexOn": ["schoolId", "eiinNumber", "schoolCode"]
    },
    "schoolData": {
      ".indexOn": ["schoolId", "updatedAt"]
    },
    "teacherPanel": {
      ".indexOn": ["schoolId", "updatedAt"]
    },
    "notices": {
      ".indexOn": ["schoolId", "targetRole", "date", "createdAt"]
    },
    "examSessions": {
      ".indexOn": ["schoolId", "targetClass", "examId", "sessionName"]
    },
    "storedResults": {
      ".indexOn": ["schoolId", "studentId", "class", "examId"]
    },
    "feeRecords": {
      ".indexOn": ["schoolId", "studentId", "status", "date"]
    }
  }
}